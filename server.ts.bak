// -----------------------------------------------------------------
// Persistent Google Drive OAuth
// -----------------------------------------------------------------
type GoogleDriveAuthState = {
  expiresAt: number;
  origin: string;
  redirectUri: string;
  uid: string;
  nonce: string;
};

const GOOGLE_DRIVE_COLLECTION = 'user_integrations';

function getGoogleDriveOAuthConfig() {
  const clientId = process.env.GOOGLE_OAUTH_CLIENT_ID || firebaseConfigData.oAuthClientId || '';
  const clientSecret = process.env.GOOGLE_OAUTH_CLIENT_SECRET || '';
  const encryptionSecret = process.env.GOOGLE_TOKEN_ENCRYPTION_KEY || '';
  return { clientId, clientSecret, encryptionSecret };
}

function createGoogleOAuthClient(redirectUri: string) {
  const { clientId, clientSecret } = getGoogleDriveOAuthConfig();
  return new google.auth.OAuth2(clientId, clientSecret, redirectUri);
}

function getTokenEncryptionKey(): Buffer {
  const { encryptionSecret } = getGoogleDriveOAuthConfig();
  return createHash('sha256').update(encryptionSecret).digest();
}

function encryptGoogleToken(token: string): string {
  const iv = randomBytes(12);
  const cipher = createCipheriv('aes-256-gcm', getTokenEncryptionKey(), iv);
  const encrypted = Buffer.concat([cipher.update(token, 'utf8'), cipher.final()]);
  const tag = cipher.getAuthTag();
  return [iv, tag, encrypted].map(value => value.toString('base64url')).join('.');
}

function decryptGoogleToken(value: string): string {
  const [ivEncoded, tagEncoded, encryptedEncoded] = value.split('.');
  if (!ivEncoded || !tagEncoded || !encryptedEncoded) throw new Error('Invalid encrypted token');
  const decipher = createDecipheriv('aes-256-gcm', getTokenEncryptionKey(), Buffer.from(ivEncoded, 'base64url'));
  decipher.setAuthTag(Buffer.from(tagEncoded, 'base64url'));
  return Buffer.concat([
    decipher.update(Buffer.from(encryptedEncoded, 'base64url')),
    decipher.final()
  ]).toString('utf8');
}

function createGoogleDriveAuthState(payload: GoogleDriveAuthState): string {
  const encodedPayload = Buffer.from(JSON.stringify(payload), 'utf8').toString('base64url');
  const signature = createHmac('sha256', getTokenEncryptionKey()).update(encodedPayload).digest('base64url');
  return `${encodedPayload}.${signature}`;
}

function verifyGoogleDriveAuthState(value: string): GoogleDriveAuthState {
  const [encodedPayload, signature] = value.split('.');
  if (!encodedPayload || !signature) throw new Error('Invalid OAuth state');

  const expectedSignature = createHmac('sha256', getTokenEncryptionKey()).update(encodedPayload).digest();
  const providedSignature = Buffer.from(signature, 'base64url');
  if (providedSignature.length !== expectedSignature.length || !timingSafeEqual(providedSignature, expectedSignature)) {
    throw new Error('Invalid OAuth state signature');
  }

  const payload = JSON.parse(Buffer.from(encodedPayload, 'base64url').toString('utf8')) as Partial<GoogleDriveAuthState>;
  if (
    typeof payload.uid !== 'string' ||
    typeof payload.origin !== 'string' ||
    typeof payload.redirectUri !== 'string' ||
    typeof payload.expiresAt !== 'number' ||
    typeof payload.nonce !== 'string' ||
    payload.expiresAt < Date.now()
  ) {
    throw new Error('Expired or malformed OAuth state');
  }
  return payload as GoogleDriveAuthState;
}

function driveIntegrationDocument(uid: string) {
  return getFirestore().collection(GOOGLE_DRIVE_COLLECTION).doc(`${uid}_google_drive`);
}

function googleDriveOAuthAvailable(): boolean {
  const { clientId, clientSecret, encryptionSecret } = getGoogleDriveOAuthConfig();
  return Boolean(clientId && clientSecret && encryptionSecret);
}

function getPublicAppOrigin(req: express.Request): string {
  const configuredUrl = process.env.APP_URL;
  if (configuredUrl) {
    try {
      return new URL(configuredUrl).origin;
    } catch {
      console.warn('APP_URL is not a valid absolute URL; using the current request host.');
    }
  }
  return `${req.protocol}://${req.get('host')}`;
}

});

app.get('/api/google-drive/oauth/callback', async (req, res) => {
  const state = String(req.query.state || '');
  const code = String(req.query.code || '');
  if (!state || !code || !googleDriveOAuthAvailable()) {
    return res.status(400).send('Google Drive authorization is invalid or expired.');
  }

  try {
    const pending = verifyGoogleDriveAuthState(state);
    const oauthClient = createGoogleOAuthClient(pending.redirectUri);
    const { tokens } = await oauthClient.getToken(code);
    if (!tokens.refresh_token) {
      throw new Error('Google did not return a refresh token');
    }
    oauthClient.setCredentials(tokens);
    const userInfo = await google.oauth2({ version: 'v2', auth: oauthClient }).userinfo.get();
    await driveIntegrationDocument(pending.uid).set({
      provider: 'google_drive',
      accountEmail: userInfo.data.email || null,
      encryptedRefreshToken: encryptGoogleToken(tokens.refresh_token),
      scopes: tokens.scope || null,
      connectedAt: new Date().toISOString(),
      updatedAt: new Date().toISOString()
    }, { merge: true });

    const safeOrigin = JSON.stringify(pending.origin);
    return res.type('html').send(`<!doctype html><html><body><script>
      if (window.opener) {
        window.opener.postMessage({ type: 'GOOGLE_DRIVE_CONNECTED' }, ${safeOrigin});
        window.close();
      } else {
        window.location.replace(${safeOrigin} + '/?google_drive=connected');
      }
    </script><p>Google Drive wurde verbunden. Dieses Fenster kann geschlossen werden.</p></body></html>`);
  } catch (error) {
    console.error('Google Drive OAuth callback failed:', error);
    return res.status(502).send('Google Drive konnte nicht dauerhaft verbunden werden.');
  }
});

app.get('/api/google-drive/token', authenticateUser, async (req, res) => {
  if (!googleDriveOAuthAvailable()) {
    return res.status(503).json({ connected: false, error: 'Persistent Google Drive OAuth is not configured' });
  }
  try {
    const uid = String((req as any).user.uid);
    const snapshot = await driveIntegrationDocument(uid).get();
    if (!snapshot.exists) return res.status(404).json({ connected: false });
    const integration = snapshot.data() || {};
    const redirectUri = process.env.GOOGLE_DRIVE_REDIRECT_URI || `${getPublicAppOrigin(req)}/api/google-drive/oauth/callback`;
    const oauthClient = createGoogleOAuthClient(redirectUri);
    oauthClient.setCredentials({ refresh_token: decryptGoogleToken(String(integration.encryptedRefreshToken || '')) });
    const accessToken = await oauthClient.getAccessToken();
    if (!accessToken.token) throw new Error('No access token returned');
    return res.json({
      connected: true,
      accessToken: accessToken.token,
      accountEmail: integration.accountEmail || null,
      expiresAt: oauthClient.credentials.expiry_date || Date.now() + 50 * 60_000
    });
  } catch (error) {
    console.error('Google Drive token refresh failed:', error);
    return res.status(401).json({ connected: false, error: 'Google Drive connection must be renewed' });
  }
});

app.delete('/api/google-drive/connection', authenticateUser, async (req, res) => {
  try {
    const uid = String((req as any).user.uid);
    const reference = driveIntegrationDocument(uid);
    const snapshot = await reference.get();
    if (snapshot.exists && googleDriveOAuthAvailable()) {
      const integration = snapshot.data() || {};
      const refreshToken = decryptGoogleToken(String(integration.encryptedRefreshToken || ''));
      await createGoogleOAuthClient(process.env.GOOGLE_DRIVE_REDIRECT_URI || '').revokeToken(refreshToken).catch(error => {
        console.warn('Google token revocation failed; deleting local connection anyway:', error);
      });
    }
    await reference.delete();
    return res.json({ disconnected: true });
  } catch (error) {
    console.error('Google Drive disconnect failed:', error);
    return res.status(500).json({ error: 'Google Drive connection could not be removed' });
  }
});

app.use(express.urlencoded({ limit: '50mb', extended: true }));

// Lazy initialize Gemini API Client
let aiClient: GoogleGenAI | null = null;
function getGeminiClient(): GoogleGenAI {
  if (!aiClient) {
    const key = process.env.GEMINI_API_KEY;
    if (!key) {
      console.warn("GEMINI_API_KEY environment variable is missing. AI features will run in offline simulation mode.");
    }
    aiClient = new GoogleGenAI({
      apiKey: key || 'MOCK_KEY',
      httpOptions: {
        headers: {
          'User-Agent': 'aistudio-build',
        },
      },
    });
  }
  return aiClient;
}

